{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 3,
  "defaultClosedDomains": [
    "security",
    "privacy",
    "accessibility",
    "money",
    "legal",
    "reliability",
    "irreversible-operations"
  ],
  "gates": {
    "1": {
      "question": "What are we building, and why?",
      "artifact": "SPEC",
      "required": ["product-lead", "product-designer"]
    },
    "2": {
      "question": "What does provably done look like?",
      "artifact": "EXAM",
      "required": ["tech-lead"]
    },
    "3": {
      "question": "Does the evidence support release?",
      "artifact": "diff",
      "required": ["product-lead", "tech-lead"],
      "productDesignerWhen": "user-facing"
    }
  },
  "specialistSeat": {
    "activatesFor": "default-closed-domain-tag",
    "mode": "agent-first-human-on-exception",
    "agentReview": {
      "required": true,
      "independentOfBuilder": true,
      "freshContext": true,
      "oneRecordPerActivatedDomain": true,
      "consolidation": "single-exception-brief"
    },
    "commercialHumanEscalation": {
      "default": "not-required-per-domain",
      "accountableGateOwner": "tech-lead",
      "triggers": [
        "unresolved-blocker-or-major-finding",
        "inconclusive-or-missing-required-evidence",
        "law-regulation-contract-or-policy-requires-human-specialist",
        "waiver-or-policy-override-requested",
        "irreversible-external-effect-or-material-rights-impact",
        "user-facing-accessibility-manual-release-validation",
        "production-release-paid-deployment-or-spend-authorization"
      ]
    },
    "regulatedHumanEscalation": {
      "default": "required-for-every-activated-domain",
      "minimumDistinctHumans": 2
    },
    "slaHours": 24,
    "escalation": "visible"
  },
  "minimumDistinctSigners": {
    "commercial": {
      "defaultOpen": {
        "humans": 1,
        "critic": "passing-fresh-context"
      },
      "defaultClosed": {
        "humans": 1,
        "critic": "passing-fresh-context-zero-unresolved",
        "secondLook": "gate-3-separate-session-after-build-critic"
      }
    },
    "regulated": {
      "defaultOpen": {
        "humans": 1,
        "critic": "passing-fresh-context"
      },
      "defaultClosed": {
        "humans": 2,
        "critic": "passing-fresh-context-zero-unresolved",
        "onboardingDisclosure": true
      }
    }
  },
  "invariants": {
    "builderMayEditExam": false,
    "signatureBinds": ["identity", "hat", "sequence", "artifact-revision"],
    "productionRequiresNamedAuthorization": true
  }
}
