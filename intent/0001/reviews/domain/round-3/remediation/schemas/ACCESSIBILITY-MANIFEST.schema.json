{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://steer.invalid/schemas/accessibility-manifest-v2.json","type":"object","additionalProperties":false,
  "required":["version","checkpointModel","routes","stories","storyStates","scenarios","viewports","environments","requiredRowFields"],
