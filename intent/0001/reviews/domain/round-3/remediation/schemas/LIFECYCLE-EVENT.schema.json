  },
  "allOf":[
    {"if":{"properties":{"eventType":{"const":"originator-session-opened"}}},"then":{"required":["sessionId","authenticatedAt"]}},
    {"if":{"properties":{"eventType":{"const":"originator-draft-saved"}}},"then":{"required":["sessionId","commitId","contentSha256"]}},
    {"if":{"properties":{"eventType":{"const":"originator-session-abandoned"}}},"then":{"required":["sessionId","reason","boundaryAt"]}},
    {"if":{"properties":{"eventType":{"const":"record-committed"}}},"then":{"required":["recordSha256"]}},
    {"if":{"properties":{"eventType":{"const":"item-closed"}}},"then":{"required":["closingRecordId","closingDecision"]}},
    {"if":{"properties":{"eventType":{"const":"environment-retired"}}},"then":{"required":["releaseRailsRecordId","trafficDisabled","credentialsRevoked"]}},
    {"if":{"properties":{"eventType":{"const":"run-terminal"}}},"then":{"required":["runId","terminalStatus"]}},
    {"if":{"properties":{"eventType":{"const":"event-committed"}}},"then":{"required":["sourceEventId","sourceEventSha256"]}},
    {"if":{"properties":{"eventType":{"const":"record-superseded"}}},"then":{"required":["predecessorRecordId","successorRecordId","successorSha256"]}},
    {"if":{"properties":{"eventType":{"const":"corpus-source-authorized"}}},"then":{"required":["sourceAuthorityId","sourceObjectSha256","purpose","useAuthorizationId","useAuthorizationSha256","authorizedThrough","allowedDerivatives"]}},
    {"if":{"properties":{"eventType":{"const":"corpus-use-authorization-revoked"}}},"then":{"required":["useAuthorizationId","revocationDecisionId","revokedAt","affectedCorpusVersions"]}},
    {"if":{"properties":{"eventType":{"const":"corpus-sanitization-terminal"}}},"then":{"required":["corpusId","sourceObjectSha256","sanitizerRevision","inspectionRevision","result","reportSha256","rawWorkingCopyDisposition","rawDispositionReceiptSha256"]}},
    {"if":{"properties":{"eventType":{"const":"corpus-version-accepted"}}},"then":{"required":["corpusId","corpusVersion","encryptedObjectSha256","manifestSha256","keyId","useAuthorizationId"]}},
    {"if":{"properties":{"eventType":{"const":"corpus-version-superseded"}}},"then":{"required":["corpusId","corpusVersion","successorVersion","successorManifestSha256"]}},
    {"if":{"properties":{"eventType":{"const":"corpus-retired"}}},"then":{"required":["corpusId","corpusVersion","retirementReason"]}},
    {"if":{"properties":{"eventType":{"const":"hold-applied"}}},"then":{"required":["holdId","selectorsSha256","reasonAuthority"]}},
    {"if":{"properties":{"eventType":{"const":"hold-released"}}},"then":{"required":["holdId","releaseAuthority"]}},
    {"if":{"properties":{"eventType":{"const":"rebuild-requested"}}},"then":{"required":["requestId","selectorSha256","authorizationRecordId"]}},
    {"if":{"properties":{"eventType":{"const":"reference-revocation-authorized"}}},"then":{"required":["authorizationRecordId","referenceInventorySha256","verificationBundleSha256","tombstoneRecordId"]}},
    {"if":{"properties":{"eventType":{"const":"raw-working-policy-grant-signed"}}},"then":{"required":["policyGrantId","grantSha256","validFrom","expiresAt","safeguards","qualifiedOwnerSubject"]}},
    {"if":{"properties":{"eventType":{"const":"derived-record-deleted"}}},"then":{"required":["parentCorpusId","parentCorpusVersion","derivedRecordId","derivedRecordClass","deletionReceiptSha256"]}},
    {"if":{"properties":{"eventType":{"const":"expiry-due"}}},"then":{"required":["triggerEventId","computedExpiryAt"]}},
    {"if":{"properties":{"eventType":{"const":"deletion-requested"}}},"then":{"required":["expiryEventId","copyInventorySha256","dispositionAuthorizationId"]}},
    {"if":{"properties":{"eventType":{"const":"deletion-completed"}}},"then":{"required":["requestId","providerReceiptsSha256","allCopiesGone"]}},
    {"if":{"properties":{"eventType":{"const":"tombstone-committed"}}},"then":{"required":["deletionEventId","tombstoneSha256"]}},
    {"if":{"properties":{"eventType":{"const":"export-authorized"}}},"then":{"required":["exportAuthorizationId","selectorsSha256","purpose","recipient","expiresAt"]}},
    {"if":{"properties":{"eventType":{"const":"export-completed"}}},"then":{"required":["exportId","exportSha256","inventorySha256","exportAuthorizationId"]}}
