{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PROVIDER-RECEIPT.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptId", "providerRequestId", "providerTransactionId", "proofIssuer", "proofType", "providerBindingId", "tenant", "recordClass", "provider", "account", "copyId", "copyKind", "objectKey", "versionId", "keyId", "tupleDigest", "inventoryDigest", "authorityId", "authorityDigest", "immutableRequestDigest", "idempotencyKey", "effect", "status", "requestTime", "providerTime", "targetExamRevision", "targetExamDigest", "retentionPolicyDigest", "authorizationPolicyDigest", "providerKeyRegistryDigest", "recordDigest", "signature"],
  "properties": {
    "receiptId": {"type": "string", "minLength": 1},
    "providerRequestId": {"type": "string", "minLength": 1},
    "providerTransactionId": {"type": "string", "minLength": 1},
    "proofIssuer": {"type": "string", "minLength": 1},
    "proofType": {"const": "Ed25519-provider-receipt"},
    "providerBindingId": {"type": "string", "minLength": 1},
    "tenant": {"type": "string", "minLength": 1},
    "recordClass": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "account": {"type": "string", "minLength": 1},
    "copyId": {"type": "string", "minLength": 1},
    "copyKind": {"type": "string", "minLength": 1},
    "objectKey": {"type": "string", "minLength": 1},
    "versionId": {"type": "string", "minLength": 1},
    "keyId": {"type": "string", "minLength": 1},
    "tupleDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inventoryDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorityId": {"type": "string", "minLength": 1},
    "authorityDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "immutableRequestDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotencyKey": {"type": "string", "minLength": 1},
    "effect": {"enum": ["deleted", "crypto-erased"]},
    "status": {"const": "terminal-success"},
    "requestTime": {"type": "string", "format": "date-time"},
    "providerTime": {"type": "string", "format": "date-time"},
    "targetExamRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "targetExamDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retentionPolicyDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorizationPolicyDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "providerKeyRegistryDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recordDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "keyId", "signedDigest", "valueBase64"], "properties": {"algorithm": {"const": "Ed25519"}, "keyId": {"type": "string", "minLength": 1}, "signedDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "valueBase64": {"type": "string", "minLength": 1}}}
  }
}
