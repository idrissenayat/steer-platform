  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://steer.invalid/schemas/accessibility-summary-v2.json","type":"object","additionalProperties":false,
  "required":["summaryId","manifestDigest","checkpointModelDigest","rowCount","notApplicableCount","failureCount","rawRowsDigest","reviewerSubject","activeHat","pod","targetExamRevision","targetExamDigest","implementationRevision","identityDigest","qualificationDigest","assignmentDigest","decision","signedAt","recordDigest","signature"],
