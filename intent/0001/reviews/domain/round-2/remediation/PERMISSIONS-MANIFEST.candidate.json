  "authoritativeStateContract": {
    "casHead": "signed provider-control-plane snapshot whose resourceSelectors exactly equal every selected provider-resource selector, including lifecycle copy/provider/object/version/class/target/policy/inventory; observed no more than 300 seconds before decision",
    "providerResource": "independently signed provider-policy snapshot binds permission, principal, action, provider and the exact request resource-selector set; @request values are resolved only from this authenticated snapshot and zero/multiple/substituted matches deny",
    "replayLedger": "signed provider idempotency ledger snapshot for exact action/key and unused or committed request digest",
    "atomicReservation": "signed provider transaction result binds request digest, CAS head, prior generation and exactly one winner; losers deny and same-key/same-bytes committed entries replay as zero-effect no-op",
    "callerCoherenceIsNotAuthority": true,
    "lifecycleDisposition": "exactly one current signed per-copy disposition authorization, or one exact per-key raw policy grant where policy permits, and one unique immutable protected provider request must bijectively match every ordered present inventory tuple before one final tombstone request"
  },
