{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steer://schemas/copy-inventory/v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "inventoryId", "tenant", "recordClass", "targetDigest", "policyDigest", "capturedAt", "copies", "presentTupleDigest", "recordDigest", "signature"],
  "properties": {
    "version": { "const": "steer-copy-inventory/v3" },
    "inventoryId": { "$ref": "#/$defs/uuid" },
    "tenant": { "type": "string", "minLength": 1 },
    "recordClass": { "type": "string", "minLength": 1 },
    "targetDigest": { "$ref": "#/$defs/sha" },
    "policyDigest": { "$ref": "#/$defs/sha" },
    "capturedAt": { "$ref": "#/$defs/time" },
    "copies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/copy" } },
    "presentTupleDigest": { "$ref": "#/$defs/sha" },
    "recordDigest": { "$ref": "#/$defs/sha" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityId", "copyId", "kind", "provider", "providerBindingId", "objectKey", "versionId", "keyId", "state"],
      "properties": {
        "authorityId": { "$ref": "#/$defs/uuid" },
        "copyId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["primary", "replica", "git-history", "fork", "cache", "backup", "provider-copy", "export", "disaster-recovery", "restored-backup"] },
        "provider": { "type": "string", "minLength": 1 },
        "providerBindingId": { "type": "string", "pattern": "^provider-binding:[a-z0-9-]+$" },
        "objectKey": { "type": "string", "minLength": 1 },
        "versionId": { "type": "string", "minLength": 1 },
        "keyId": { "type": "string", "minLength": 1 },
        "state": { "enum": ["present", "deleted", "unknown"] }
      }
    },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": { "type": "string", "format": "uuid" },
    "time": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "keyId", "publicKeyHex", "signedDigest", "valueBase64"],
      "properties": {
        "algorithm": { "const": "Ed25519" }, "keyId": { "type": "string", "minLength": 1 },
        "publicKeyHex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signedDigest": { "$ref": "#/$defs/sha" }, "valueBase64": { "type": "string", "minLength": 1 }
      }
    }
  },
  "x-steer-semantic-checks": [
    "present copies are sorted by UTF-8 RFC8785-JCS bytes of the authorityId/copyId/kind/provider/providerBindingId/objectKey/versionId/keyId tuple",
    "presentTupleDigest equals SHA-256 of the UTF-8 RFC8785-JCS ordered present tuple array",
    "authorityId is unique across every present copy"
  ]
}
