{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steer://schemas/provider-key-registry/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "registryId", "revision", "issuedAt", "bindings", "registryDigest"],
  "properties": {
    "version": { "const": "steer-provider-key-registry/v1" },
    "registryId": { "$ref": "#/$defs/uuid" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "issuedAt": { "$ref": "#/$defs/time" },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/binding" }
    },
    "registryDigest": { "$ref": "#/$defs/sha" }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingId", "provider", "providerAccountId", "tenant", "proofType", "proofIssuer", "keys"],
      "properties": {
        "bindingId": { "type": "string", "pattern": "^provider-binding:[a-z0-9-]+$" },
        "provider": { "type": "string", "minLength": 1 },
        "providerAccountId": { "type": "string", "minLength": 1 },
        "tenant": { "type": "string", "minLength": 1 },
        "proofType": { "const": "detached-jcs-digest-signature" },
        "proofIssuer": { "type": "string", "format": "uri" },
        "keys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/key" } }
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "publicKeyHex", "notBefore", "notAfter", "revokedAt"],
      "properties": {
        "keyId": { "type": "string", "minLength": 1 },
        "algorithm": { "enum": ["Ed25519"] },
        "publicKeyHex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "notBefore": { "$ref": "#/$defs/time" },
        "notAfter": { "$ref": "#/$defs/time" },
        "revokedAt": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] }
      }
    },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": { "type": "string", "format": "uuid" },
    "time": { "type": "string", "format": "date-time" }
  },
  "x-steer-semantic-checks": [
    "registryDigest is SHA-256 of RFC8785-JCS bytes with registryDigest omitted and byte-matches the immutable candidate manifest trust anchor",
    "bindingId, provider, account, tenant, proof type and issuer are unique and selected outside receipt-controlled bytes",
    "key IDs and public keys are unique, validity intervals are non-empty, and revokedAt cannot authorize a receipt at or after revocation"
  ]
}
