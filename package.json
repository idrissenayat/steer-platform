{
  "name": "@steer/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:prototype": "vite",
    "dev:web": "pnpm --filter @steer/web dev",
    "build": "pnpm build:prototype && turbo run build --filter='./apps/*' --filter='./packages/*'",
    "build:prototype": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:controls": "node --test tests/exam-protection.test.mjs",
    "test:watch": "vitest",
    "test:workspace": "turbo run test --filter='./apps/*' --filter='./packages/*'",
    "typecheck": "pnpm typecheck:prototype && turbo run typecheck --filter='./apps/*' --filter='./packages/*'",
    "typecheck:prototype": "tsc --noEmit",
    "kit:check": "node scripts/validate-kit.mjs",
    "security:check": "node scripts/audit-workflow-scopes.mjs",
    "check": "pnpm kit:check && pnpm security:check && pnpm typecheck && pnpm test && pnpm test:controls && pnpm test:workspace && pnpm build"
  },
  "dependencies": {
    "@steer/domain": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "turbo": "2.10.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
